# App
APP_ENV=development
APP_URL=http://localhost/task_management_v2

# Database (choose DATABASE_URL or PG* vars)
# DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/your_db_name
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=your_db_name
# PGUSER=your_db_user
# PGPASSWORD=your_db_password
# PGSSLMODE=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password

# Mail
#
# MAIL_DRIVER controls which transport is used:
#   smtp    — always use SMTP (requires MAIL_USERNAME + MAIL_PASSWORD)
#   resend  — always use Resend API (requires RESEND_API_KEY)
#   auto    — uses Resend on Railway if RESEND_API_KEY is set, otherwise SMTP
#
# --- Gmail SMTP (recommended for self-hosted / local) ---
# 1. Enable 2-Step Verification on your Google Account.
# 2. Go to myaccount.google.com/apppasswords and generate an App Password.
# 3. Use that 16-character App Password as MAIL_PASSWORD (not your Gmail login password).
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME=Task Management System

# --- Resend (optional — only required when MAIL_DRIVER=resend or MAIL_DRIVER=auto on Railway) ---
# Sign up at resend.com, verify a sending domain, and paste the API key below.
# RESEND_FROM_ADDRESS overrides the default "from" header (e.g. "TaskFlow <noreply@yourdomain.com>").
# RESEND_TEST_TO redirects all verification-code emails to a single address (useful for staging).
RESEND_API_KEY=
RESEND_FROM_ADDRESS=
RESEND_TEST_TO=

ALLOW_MAINTENANCE_SCRIPTS=0
ALLOW_GLOBAL_MAINTENANCE=1
